                    </div>
                    <button onclick="toggleNewTwisterForm()" id="openNewTwisterBtn" class="px-4 py-2.5 rounded-xl bg-studio-amber hover:bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center gap-1.5 shadow-lg shadow-amber-500/20 transition active:scale-[0.98]">
                        <span>+ Добавить</span>
                    </button>
