        function formatTeleprompterMarkup(rawText) {
            const escaped = rawText
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            return escaped
                .replace(/\*([^*]+)\*/g, '<span class="tp-stress">$1</span>')
                .replace(/\|\|/g, '<span class="tp-pause-deep">||</span>')
                .replace(/\|/g, '<span class="tp-pause-short">|</span>')
                .replace(/↗/g, '<span class="tp-arrow-up">↗</span>')
                .replace(/↘/g, '<span class="tp-arrow-down">↘</span>')
                .replace(/\n/g, '<br>');
        }

