        function parseClustersToSyllables(rawInput) {
            const tokens = rawInput
                .split(/[,;\s\n]+/)
                .map(t => t.trim().toUpperCase())
                .filter(Boolean);

            const vowels = ['А', 'О', 'У', 'Э', 'И', 'Ы'];
            const consonantEndRegex = /[БВГДЖЗЙКЛМНПРСТФХЦЧШЩ]$/;
            const result = [];

            tokens.forEach(tok => {
                if (consonantEndRegex.test(tok)) {
                    vowels.forEach(v => result.push(tok + v));
                } else {
                    result.push(tok);
                }
            });
            return result;
        }

