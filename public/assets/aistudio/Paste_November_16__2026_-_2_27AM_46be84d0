        /* =========================================================================
         * 8. ВКЛАДКА 1: ТРЕНИРОВКИ (АВТОКУРС ПО ДНЯМ + 32 УПРАЖНЕНИЯ)
         * ========================================================================= */
        function getCourseProgramForDay(dayNumber) {
            const safeDay = Math.max(1, Number(dayNumber) || 1);
            const idx = (safeDay - 1) % COURSE_DAYS.length;
            const cycleNum = Math.floor((safeDay - 1) / COURSE_DAYS.length) + 1;
            const template = COURSE_DAYS[idx];
            return {
                id: 'daily_course',
                dayNumber: safeDay,
                dayInCycle: idx + 1,
                totalInCycle: COURSE_DAYS.length,
                cycleNum,
                title: `День ${safeDay}: ${template.title}`,
                shortTitle: template.title,
                focus: template.focus,
                approxMin: template.approxMin,
                steps: template.steps
            };
        }

        function isDailyCourseCompletedToday() {
            return appState.lastCompletedCourseDate === getTodayIsoDate();
        }

        function markDailyCourseCompleted() {
            const today = getTodayIsoDate();
            if (!appState.completedDates.includes(today)) {
                appState.completedDates.push(today);
            }
            appState.lastCompletedCourseDate = today;
            appState.completedPrograms += 1;
            appState.streakDays = calculateCurrentStreak();
            saveAppState();
            updateHeaderStreakUI();
            renderDailyCourseCard();
            renderProgressDashboard();
        }

        function renderDailyCourseCard() {
            const prog = getCourseProgramForDay(appState.courseDayNumber);
            const doneToday = isDailyCourseCompletedToday();

            const cycleEl = document.getElementById('dailyCourseCycleLabel');
            const dayBadge = document.getElementById('dailyCourseDayBadge');
            const durBadge = document.getElementById('dailyCourseDurationBadge');
