                activeTwisterId = activeTw.id;
                document.getElementById('activeTwisterSoundBadge').textContent = activeTw.soundTag;
                document.getElementById('activeTwisterDiffBadge').textContent = activeTw.difficulty;
                document.getElementById('activeTwisterMyBadge').classList.toggle('hidden', !activeTw.isCustom);
                document.getElementById('activeTwisterLargeText').textContent = activeTw.text;
            }

            if (!container) return;
            if (!filtered.length) {
                container.innerHTML = `<div class="text-xs text-slate-400 text-center py-3">В этой категории пока нет скороговорок. Нажмите «+ Добавить».</div>`;
                return;
            }

            container.innerHTML = filtered.map(tw => {
                const isSel = tw.id === activeTwisterId;
                return `
                    <div onclick="selectActiveTwister('${tw.id}')" class="cursor-pointer p-3 rounded-xl border transition ${isSel ? 'bg-studio-amber/12 border-studio-amber/70' : 'bg-studio-bg border-studio-border hover:border-slate-500'}">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="px-1.5 py-0.5 rounded bg-studio-cyan/15 text-studio-cyan font-mono text-[10px] font-bold">${tw.soundTag}</span>
                                <span class="text-[10px] text-slate-400 font-semibold">${tw.difficulty}</span>
                                ${tw.isCustom ? '<span class="px-1.5 py-0.5 rounded bg-studio-amber text-slate-950 text-[9px] font-black">Моя</span>' : ''}
                            </div>
                            ${tw.isCustom ? `<button type="button" onclick="deleteCustomTwister('${tw.id}', event)" class="text-[11px] font-bold text-slate-400 hover:text-studio-rose px-1">Удалить</button>` : ''}
                        </div>
                        <p class="text-xs text-slate-200 leading-relaxed line-clamp-2">${tw.text}</p>
                    </div>
                `;
            }).join('');
        }

        async function toggleQuickDictationRec() {
            const btn = document.getElementById('quickDictRecBtn');
            const label = document.getElementById('quickDictRecLabel');
            const timerEl = document.getElementById('quickDictTimer');
            const audioEl = document.getElementById('quickDictAudio');

            if (isQuickDictRecording) {
                isQuickDictRecording = false;
                clearInterval(quickDictTimerInterval);
                if (quickDictRecorder && quickDictRecorder.state !== 'inactive') {
                    quickDictRecorder.stop();
                }
                if (quickDictStream) {
                    quickDictStream.getTracks().forEach(t => t.stop());
                    quickDictStream = null;
                }
                btn.className = 'w-full py-3 rounded-xl bg-studio-card border border-studio-rose/60 text-studio-rose hover:bg-studio-rose/10 font-extrabold text-xs flex items-center justify-center gap-2 transition';
                label.textContent = 'Записать скороговорку';
                return;
            }

            try {
                quickDictStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                quickDictChunks = [];
                quickDictRecorder = new MediaRecorder(quickDictStream);
                quickDictRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) quickDictChunks.push(e.data);
                };
                quickDictRecorder.onstop = () => {
                    const blob = new Blob(quickDictChunks, { type: quickDictRecorder.mimeType || 'audio/webm' });
                    audioEl.src = URL.createObjectURL(blob);
                    audioEl.classList.remove('hidden');
                    showToast('Запись скороговорки готова к прослушиванию', 'success');
                };

                quickDictRecorder.start();
                isQuickDictRecording = true;
                quickDictStartTime = Date.now();
                btn.className = 'w-full py-3 rounded-xl bg-studio-rose text-white font-extrabold text-xs flex items-center justify-center gap-2 rec-pulse transition';
                label.textContent = '■ Остановить запись';

                quickDictTimerInterval = setInterval(() => {
                    const sec = Math.floor((Date.now() - quickDictStartTime) / 1000);
                    if (timerEl) timerEl.textContent = formatMMSS(sec);
                }, 250);
            } catch (err) {
                showToast('Нет доступа к микрофону устройства', 'error');
            }
        }

        /* =========================================================================
         * 12. ВКЛАДКА 4: ПРОГРЕСС И СТАТИСТИКА ДИКТОРА
         * ========================================================================= */
        function renderProgressDashboard() {
            const exEl = document.getElementById('statExercisesDone');
            const progEl = document.getElementById('statProgramsDone');
            const egEl = document.getElementById('statEgorkiRecord');
            const custEl = document.getElementById('statCustomAssetsCount');
            const breakEl = document.getElementById('statCustomBreakdown');
            const egDetailEl = document.getElementById('statEgorkiDetail');
            const histList = document.getElementById('aiHistoryList');

            // Обновление дневника регулярности и 14-дневного календаря
            const courseTitleEl = document.getElementById('progressCourseStatusTitle');
            const todayPillEl = document.getElementById('progressTodayPill');
            const totalActiveEl = document.getElementById('progressTotalActiveDays');
            const grid14El = document.getElementById('progress14DaysGrid');

            const doneToday = isDailyCourseCompletedToday();
            const currDay = appState.courseDayNumber || 1;
            const completedSet = new Set(appState.completedDates || []);

            if (courseTitleEl) {
                courseTitleEl.textContent = doneToday
                    ? `День ${currDay} выполнен • Завтра откроется День ${currDay + 1}`
                    : `Активный этап: День ${currDay} автокурса`;
            }
            if (todayPillEl) {
                if (doneToday) {
                    todayPillEl.className = 'px-2.5 py-1 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[10px] font-extrabold shrink-0';
                    todayPillEl.textContent = '✅ Пройдено сегодня';
                } else {
                    todayPillEl.className = 'px-2.5 py-1 rounded-xl bg-studio-amber/15 border border-studio-amber/40 text-studio-amber text-[10px] font-extrabold shrink-0';
                    todayPillEl.textContent = '⏳ Не пройдено сегодня';
                }
            }
            if (totalActiveEl) {
                totalActiveEl.textContent = `Активных дней: ${completedSet.size}`;
            }
            if (grid14El) {
                const todayIso = getTodayIsoDate();
                const cells = [];
                for (let offset = -13; offset <= 0; offset++) {
                    const d = new Date();
                    d.setDate(d.getDate() + offset);
                    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                    const isDone = completedSet.has(iso);
                    const isToday = iso === todayIso;
                    const ddmm = `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}`;

                    let cls = 'bg-studio-bg border-studio-border text-slate-500';
                    let mark = '—';
                    if (isDone) {
                        cls = 'bg-emerald-500/20 border-emerald-500/60 text-emerald-300';
                        mark = '✓';
                    } else if (isToday) {
                        cls = 'bg-studio-amber/15 border-studio-amber text-studio-amber';
                        mark = '•';
                    }

                    cells.push(`
                        <div class="rounded-lg border ${cls} py-1.5 flex flex-col items-center justify-center">
                            <span class="text-[9px] font-mono opacity-80">${ddmm}</span>
                            <span class="text-[11px] font-black leading-tight mt-0.5">${mark}</span>
                        </div>
                    `);
                }
                grid14El.innerHTML = cells.join('');
            }

            if (exEl) exEl.textContent = appState.totalExerciseRuns || 0;
            if (progEl) progEl.textContent = appState.completedPrograms || 0;
            if (egEl) egEl.textContent = appState.egorkiBestCount || 0;

            const totalCustom = appState.customScripts.length + appState.customTwisters.length + appState.customDictionTables.length;
            if (custEl) custEl.textContent = totalCustom;
            if (breakEl) {
                breakEl.textContent = `${appState.customScripts.length} текстов • ${appState.customTwisters.length} скороговорок • ${appState.customDictionTables.length} таблиц`;
            }

            if (egDetailEl) {
                egDetailEl.textContent = appState.egorkiBestCount > 0
                    ? `Ваш лучший результат: ${appState.egorkiBestCount} из 33 Егорок на одном выдохе!`
                    : 'Рекорд «33 Егорки»: пока не установлен.';
            }

            if (!histList) return;
            if (!appState.aiHistory.length) {
                histList.innerHTML = `
                    <div class="bg-studio-card border border-studio-border rounded-2xl p-5 text-center space-y-2">
                        <div class="text-xs font-bold text-slate-300">Пока нет сохраненных разборов из Студии</div>
                        <p class="text-[11px] text-slate-400">Запишите дубль во вкладке «Студия и ИИ» и нажмите «Разобрать дубль с ИИ», чтобы отслеживать динамику голоса.</p>
                    </div>
                `;
                return;
            }

            histList.innerHTML = appState.aiHistory.map(item => {
                const recEx = EXERCISES_DB.find(e => e.id === item.recommendedExId);
                return `
                    <div class="bg-studio-card border border-studio-border rounded-2xl p-3.5 space-y-2">
                        <div class="flex items-center justify-between gap-2">
                            <div class="min-w-0">
                                <span class="text-[10px] font-mono text-slate-400">${item.date} • ${item.scriptTitle}</span>
                                <h4 class="text-xs font-extrabold text-white truncate">${item.headline}</h4>
                            </div>
                            <span class="px-2.5 py-1 rounded-xl bg-studio-amber/15 border border-studio-amber/40 font-mono text-xs font-black text-studio-amber shrink-0">
                                ${item.totalScore}/10
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-300 leading-relaxed">${item.critique}</p>
                        ${recEx ? `
                            <button onclick="openExerciseModal('${recEx.id}')" class="text-[11px] font-extrabold text-studio-cyan hover:underline">
                                Упражнение: «${recEx.title}» →
                            </button>
                        ` : ''}
                    </div>
                `;
            }).join('');
        }

        function clearProgressHistory() {
            appState.aiHistory = [];
            saveAppState();
            renderProgressDashboard();
            showToast('История оценок очищена', 'info');
        }
    </script>
