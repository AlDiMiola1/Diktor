        async function toggleStudioRecording() {
            const btn = document.getElementById('studioRecordBtn');
            const btnText = document.getElementById('studioRecordBtnText');
            const hint = document.getElementById('studioWaveHint');
            const ledDot = document.getElementById('studioLedDot');
            const ledText = document.getElementById('studioLedText');

            if (isStudioRecording) {
                isStudioRecording = false;
                clearInterval(studioRecTimerInterval);
                if (studioWaveRaf) cancelAnimationFrame(studioWaveRaf);
                if (studioMediaRecorder && studioMediaRecorder.state !== 'inactive') {
                    studioMediaRecorder.stop();
                }
                if (studioMicStream) {
                    studioMicStream.getTracks().forEach(t => t.stop());
                    studioMicStream = null;
                }
                if (studioAudioCtx) {
                    studioAudioCtx.close().catch(() => {});
                    studioAudioCtx = null;
                }
                btn.classList.remove('rec-pulse');
                btnText.textContent = 'Записать новый дубль';
                ledDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
                ledText.textContent = 'REC';
                return;
            }

            try {
                studioMicStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                studioAudioChunks = [];
                studioRecordedBlob = null;

                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                studioAudioCtx = new AudioCtx();
                const source = studioAudioCtx.createMediaStreamSource(studioMicStream);
                const analyser = studioAudioCtx.createAnalyser();
                analyser.fftSize = 256;
                source.connect(analyser);
                const timeData = new Uint8Array(analyser.frequencyBinCount);

                const samplesRms = [];
                studioMediaRecorder = new MediaRecorder(studioMicStream);
                studioMediaRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) studioAudioChunks.push(e.data);
                };
                studioMediaRecorder.onstop = () => {
                    studioRecordedBlob = new Blob(studioAudioChunks, { type: studioMediaRecorder.mimeType || 'audio/webm' });
                    const audioUrl = URL.createObjectURL(studioRecordedBlob);
                    const player = document.getElementById('studioAudioPlayer');
                    player.src = audioUrl;
                    document.getElementById('studioPlaybackSection').classList.remove('hidden');

                    const durationSec = Math.max(1, (Date.now() - studioRecStartTime) / 1000);
                    const avgRms = samplesRms.length ? samplesRms.reduce((a, b) => a + b, 0) / samplesRms.length : 0.08;
                    const maxRms = samplesRms.length ? Math.max(...samplesRms) : 0.2;
                    const silentFrames = samplesRms.filter(v => v < 0.015).length;
                    const pauseRatio = samplesRms.length ? silentFrames / samplesRms.length : 0.2;
                    const tailSlice = samplesRms.slice(-Math.max(5, Math.floor(samplesRms.length * 0.2)));
                    const tailRms = tailSlice.length ? tailSlice.reduce((a, b) => a + b, 0) / tailSlice.length : avgRms;

                    studioAcousticStats = { durationSec, avgRms, maxRms, pauseRatio, tailRms };
                    showToast('Дубль записан! Нажмите «Разобрать дубль с ИИ»', 'success');
                };

                studioMediaRecorder.start();
                isStudioRecording = true;
                studioRecStartTime = Date.now();
                if (hint) hint.classList.add('hidden');
                btn.classList.add('rec-pulse');
                btnText.textContent = '■ Остановить запись';
                ledDot.className = 'w-2 h-2 rounded-full bg-rose-500 animate-ping';
                ledText.textContent = 'ON AIR';

                studioRecTimerInterval = setInterval(() => {
                    const sec = Math.floor((Date.now() - studioRecStartTime) / 1000);
                    document.getElementById('studioRecTimer').textContent = formatMMSS(sec);
                }, 250);

                const canvas = document.getElementById('studioWaveCanvas');
                const drawWave = () => {
                    if (!isStudioRecording || !canvas) return;
                    analyser.getByteTimeDomainData(timeData);

                    let sumSq = 0;
                    for (let i = 0; i < timeData.length; i++) {
                        const norm = (timeData[i] - 128) / 128;
                        sumSq += norm * norm;
                    }
                    samplesRms.push(Math.sqrt(sumSq / timeData.length));

                    const dpr = window.devicePixelRatio || 1;
                    const w = canvas.clientWidth || 320;
                    const h = canvas.clientHeight || 64;
                    canvas.width = w * dpr;
                    canvas.height = h * dpr;
                    const ctx = canvas.getContext('2d');
                    ctx.scale(dpr, dpr);
                    ctx.clearRect(0, 0, w, h);

                    ctx.lineWidth = 2.5;
                    ctx.strokeStyle = '#F59E0B';
                    ctx.beginPath();
                    const sliceW = w / timeData.length;
                    let x = 0;
                    for (let i = 0; i < timeData.length; i++) {
                        const v = timeData[i] / 128.0;
                        const y = (v * h) / 2;
                        if (i === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                        x += sliceW;
                    }
                    ctx.stroke();
                    studioWaveRaf = requestAnimationFrame(drawWave);
                };
                drawWave();
            } catch (err) {
                showToast('Не удалось получить доступ к микрофону устройства', 'error');
            }
        }

        function blobToBase64(blob) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => {
                    const res = reader.result || '';
                    const base64 = res.toString().split(',')[1] || '';
                    resolve(base64);
                };
                reader.onerror = reject;
                reader.readAsDataURL(blob);
            });
        }

        function buildLocalAcousticVerdict(stats, scriptObj) {
            const s = stats || { durationSec: 12, avgRms: 0.08, maxRms: 0.22, pauseRatio: 0.22, tailRms: 0.06 };
            const chestScore = Math.min(10, Math.max(5, Math.round(6 + s.avgRms * 28)));
            const supportScore = s.tailRms < s.avgRms * 0.55 ? 6 : 8;
            const pauseScore = (s.pauseRatio >= 0.14 && s.pauseRatio <= 0.42) ? 9 : 6;
            const dictionScore = s.maxRms > 0.12 ? 8 : 7;
            const total = Math.round((chestScore + supportScore + pauseScore + dictionScore) / 4);

            let critique = 'В концовках длинных предложений немного падает воздушная опора — последние слова звучат тише середины фразы.';
            let advice = 'Перед каждой глубокой паузой || добирайте воздух нижними ребрами и дотягивайте последнее ударное слово грудью ↘.';
            let recExId = 'tarzan_chest';

            if (s.pauseRatio < 0.14) {
                critique = 'Слишком плотный темп: короткие паузы | и глубокие вдохи || пролетают без остановки.';
                advice = 'Делайте честную остановку на 0.5–1 секунду на знаках | и ||, чтобы слушатель успевал осмыслить фразу.';
                recExId = 'semantic_magnet';
            } else if (s.avgRms < 0.04) {
                critique = 'Звук идет преимущественно на связках без активного включения грудного резонатора.';
                advice = 'Опустите гортань скрытым зевком и разогрейте грудную клетку мычанием перед следующим дублем.';
                recExId = 'hidden_yawn';
            } else if (supportScore <= 6) {
                recExId = 'candle_breath';
            }

            return {
                modeLabel: 'Акустический разбор',
                headline: total >= 8 ? 'Уверенная студийная подача' : 'Хорошая база — усиливаем опору',
                totalScore: total,
                scores: [
                    { label: 'Грудной резонатор', val: chestScore },
                    { label: 'Опора и концовки', val: supportScore },
                    { label: 'Темп и паузы', val: pauseScore },
                    { label: 'Четкость дикции', val: dictionScore }
                ],
                critique,
                advice,
                recommendedExId: recExId,
                scriptTitle: scriptObj ? scriptObj.title : 'Студийный текст'
            };
        }

