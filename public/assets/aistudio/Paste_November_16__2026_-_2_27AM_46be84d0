        function startProgram(programId) {
            if (programId === 'daily_course') {
                startDailyCourseWorkout();
                return;
            }
            const prog = DAILY_PROGRAMS[programId];
            if (!prog) return;
            activeProgramState = { programId, customProg: prog, stepIndex: 0 };
            runProgramStep();
        }

        function runProgramStep() {
            if (!activeProgramState) return;
            const prog = activeProgramState.customProg || DAILY_PROGRAMS[activeProgramState.programId];
            const isDailyCourse = activeProgramState.programId === 'daily_course';
            const step = prog.steps[activeProgramState.stepIndex];

            if (!step) {
                if (isDailyCourse) {
                    markDailyCourseCompleted();
                } else {
                    appState.completedPrograms += 1;
                    recordDailyStreakActivity();
                    saveAppState();
                    renderProgressDashboard();
                }
                activeProgramState = null;
                closeExerciseModal();
                soundFX.playChime('complete');
                showToast(
                    isDailyCourse
                        ? `Отлично! День ${prog.dayNumber} пройден. Завтра откроется День ${prog.dayNumber + 1}!`
                        : `Программа «${prog.title}» завершена!`,
                    'success'
                );
                return;
            }

            if (step.action === 'go_studio') {
                if (isDailyCourse) {
                    markDailyCourseCompleted();
                } else {
                    appState.completedPrograms += 1;
                    recordDailyStreakActivity();
                    saveAppState();
                    renderProgressDashboard();
                }
                activeProgramState = null;
                closeExerciseModal();
                soundFX.playChime('complete');
                switchMainTab('studio');
                showToast(
                    isDailyCourse
                        ? `День ${prog.dayNumber} засчитан! Запишите контрольный дубль`
                        : 'Разогрев завершен! Запишите контрольный дубль',
                    'success'
                );
                return;
            }

            openExerciseModal(step.exId, step.duration);
        }

        function cleanupModalTimersAndStreams() {
            modalIntervals.forEach(id => clearInterval(id));
            modalIntervals = [];
            if (modalRafId) {
                cancelAnimationFrame(modalRafId);
                modalRafId = null;
            }
            if (modalMicStream) {
                modalMicStream.getTracks().forEach(t => t.stop());
                modalMicStream = null;
            }
            if (modalAudioCtx) {
                modalAudioCtx.close().catch(() => {});
                modalAudioCtx = null;
            }
        }

        function closeExerciseModal() {
            cleanupModalTimersAndStreams();
            activeProgramState = null;
            currentModalExId = null;
            document.getElementById('exerciseModal').classList.add('hidden');
            renderExercisesCatalog();
        }

        function completeCurrentExercise() {
            if (currentModalExId) {
                if (!appState.completedExercises.includes(currentModalExId)) {
                    appState.completedExercises.push(currentModalExId);
