            if (cycleEl) cycleEl.textContent = `Цикл ${prog.cycleNum} • День ${prog.dayInCycle}/${prog.totalInCycle}`;
            if (dayBadge) dayBadge.textContent = `ДЕНЬ ${prog.dayNumber}`;
            if (durBadge) durBadge.textContent = `~${prog.approxMin} МИН`;
            if (titleEl) titleEl.textContent = prog.shortTitle;
            if (focusEl) focusEl.textContent = prog.focus;

            if (statusBadge && heroCard && startBtn && earlyBtn) {
                if (doneToday) {
                    heroCard.className = 'bg-studio-card border border-emerald-500/50 rounded-2xl p-4 shadow-xl space-y-3.5';
                    statusBadge.className = 'px-2.5 py-1 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[10px] font-extrabold shrink-0';
                    statusBadge.textContent = '✅ Пройдено сегодня';
                    startBtn.className = 'w-full py-3 px-4 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/50 text-emerald-300 font-extrabold text-xs flex items-center justify-center gap-2 transition';
                    startBtn.innerHTML = `<span>↻ Повторить День ${prog.dayNumber} (следующий откроется завтра)</span>`;
                    earlyBtn.classList.remove('hidden');
                    earlyBtn.textContent = `Пройти День ${prog.dayNumber + 1} досрочно →`;
                } else {
                    heroCard.className = 'bg-studio-card border border-studio-amber/50 rounded-2xl p-4 shadow-xl space-y-3.5';
                    statusBadge.className = 'px-2.5 py-1 rounded-xl bg-studio-amber/15 border border-studio-amber/40 text-studio-amber text-[10px] font-extrabold shrink-0';
                    statusBadge.textContent = '⏳ Не пройдено';
                    startBtn.className = 'w-full py-3.5 px-4 rounded-xl bg-studio-amber hover:bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition active:scale-[0.99]';
                    startBtn.innerHTML = `<span>▶ Начать тренировку Дня ${prog.dayNumber}</span>`;
                    earlyBtn.classList.add('hidden');
                }
            }

            // Отрисовка шагов сегодняшней тренировки по порядку
            if (stepsBox) {
                stepsBox.innerHTML = prog.steps.map((st, idx) => {
                    if (st.action === 'go_studio') {
                        return `
                            <div class="flex items-center justify-between bg-studio-bg/80 border border-studio-cyan/30 rounded-lg px-2.5 py-1.5 text-xs">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-4 h-4 rounded-full bg-studio-cyan/20 text-studio-cyan font-mono text-[10px] font-black flex items-center justify-center shrink-0">${idx + 1}</span>
                                    <span class="font-bold text-studio-cyan truncate">Контрольный дубль в Студии и ИИ</span>
                                </div>
                                <span class="text-[10px] font-mono text-slate-400 shrink-0">Эфир</span>
                            </div>
                        `;
                    }
                    const ex = EXERCISES_DB.find(e => e.id === st.exId);
                    if (!ex) return '';
                    return `
                        <div class="flex items-center justify-between bg-studio-bg/80 border border-studio-border/80 rounded-lg px-2.5 py-1.5 text-xs">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-4 h-4 rounded-full bg-studio-amber/20 text-studio-amber font-mono text-[10px] font-black flex items-center justify-center shrink-0">${idx + 1}</span>
                                <span class="font-bold text-slate-200 truncate">${ex.title}</span>
                            </div>
                            <span class="text-[10px] font-mono text-slate-400 shrink-0">${st.duration}с</span>
                        </div>
                    `;
                }).join('');
            }

            // Отрисовка 7-дневного трекера текущей недели (Пн – Вс)
            const weekStrip = document.getElementById('dailyWeekTrackerStrip');
            const weekCountEl = document.getElementById('dailyWeekDoneCount');
            if (weekStrip) {
                const now = new Date();
                const todayIso = getTodayIsoDate();
                const mondayShift = (now.getDay() + 6) % 7; // 0 = Пн ... 6 = Вс
                const dayNames = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
                const completedSet = new Set(appState.completedDates || []);
                let weekDone = 0;

                weekStrip.innerHTML = dayNames.map((name, i) => {
                    const d = new Date(now);
                    d.setDate(now.getDate() - mondayShift + i);
                    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                    const isDone = completedSet.has(iso);
                    const isToday = iso === todayIso;
                    if (isDone) weekDone += 1;

                    let boxCls = 'bg-studio-card border-studio-border text-slate-500';
                    let icon = String(d.getDate());
                    if (isDone) {
                        boxCls = 'bg-emerald-500/20 border-emerald-500/60 text-emerald-300';
                        icon = '✓';
                    } else if (isToday) {
                        boxCls = 'bg-studio-amber/15 border-studio-amber text-studio-amber';
                    }

                    return `
                        <div class="rounded-lg border ${boxCls} py-1.5 flex flex-col items-center justify-center">
                            <span class="text-[9px] font-bold uppercase opacity-80">${name}</span>
                            <span class="text-[11px] font-mono font-black leading-tight mt-0.5">${icon}</span>
                        </div>
                    `;
                }).join('');

                if (weekCountEl) weekCountEl.textContent = `${weekDone} / 7 дн.`;
            }
        }

