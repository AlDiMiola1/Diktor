                            <button type="button" onclick="selectNewTwisterSound('П / Т / К', this)" class="nt-sound-btn px-2.5 py-1.5 rounded-lg text-xs font-bold bg-studio-card border border-studio-border text-slate-300">П / Т / К</button>
                            <button type="button" onclick="selectNewTwisterSound('Шипящие', this)" class="nt-sound-btn px-2.5 py-1.5 rounded-lg text-xs font-bold bg-studio-card border border-studio-border text-slate-300">Шипящие</button>
                            <button type="button" onclick="selectNewTwisterSound('Свой вариант', this)" class="nt-sound-btn px-2.5 py-1.5 rounded-lg text-xs font-bold bg-studio-card border border-studio-border text-slate-300">Свой вариант</button>
