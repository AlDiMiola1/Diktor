                        <span>50 BPM</span>
                        <span>95 BPM</span>
                        <span>140 BPM</span>
                    </div>
                </div>

                <!-- Пресеты 60 / 90 / 120 + Старт/Стоп -->
                <div class="flex items-center gap-2">
                    <div class="grid grid-cols-3 gap-1.5 flex-1 bg-studio-bg p-1 rounded-xl border border-studio-border">
                        <button onclick="updateDictionBpm(60)" class="py-2 rounded-lg text-xs font-mono font-bold text-slate-300 hover:bg-studio-surface transition">60</button>
                        <button onclick="updateDictionBpm(90)" class="py-2 rounded-lg text-xs font-mono font-bold text-slate-300 hover:bg-studio-surface transition">90</button>
                        <button onclick="updateDictionBpm(120)" class="py-2 rounded-lg text-xs font-mono font-bold text-slate-300 hover:bg-studio-surface transition">120</button>
                    </div>
                    <button id="dictionMetroBtn" onclick="toggleDictionMetronome()" class="px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs transition shrink-0">
                        ▶ Старт
                    </button>
                </div>
            </div>

            <!-- 2. Интерактивные таблицы согласных -->
            <div class="bg-studio-card border border-studio-border rounded-2xl px-2.5 py-3.5 space-y-2.5">
                <div class="flex flex-wrap items-center justify-between gap-2 px-0.5">
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-300">Таблицы согласных</h3>
