        function startDictionMetronomeLoop() {
            const intervalMs = Math.round(60000 / dictionBpm);
            const tick = () => {
                const isAccent = dictionBeatIndex === 0;
                soundFX.playClick(isAccent);

                for (let i = 0; i < 4; i++) {
                    const led = document.getElementById(`beat-led-${i}`);
                    if (!led) continue;
                    if (i === dictionBeatIndex) {
                        led.className = isAccent
                            ? 'h-3 rounded-full bg-studio-amber shadow-md shadow-amber-500/50 transition-all duration-75'
                            : 'h-3 rounded-full bg-studio-cyan shadow-md shadow-cyan-500/50 transition-all duration-75';
                    } else {
                        led.className = 'h-3 rounded-full bg-studio-bg border border-studio-border transition-all duration-75';
                    }
                }

                const tableObj = getActiveDictionTableObject();
                const syllables = tableObj.syllables;
                const baseCls = 'px-0.5 py-1 rounded-md text-center font-mono text-[10px] sm:text-[11px] tracking-tight';

                if (syllables.length > 0) {
                    if (dictionSyllableIndex >= syllables.length) dictionSyllableIndex = 0;
                    const progEl = document.getElementById('dictionSyllableProgress');
                    if (progEl) progEl.textContent = `Слог: ${dictionSyllableIndex + 1} / ${syllables.length}`;

                    syllables.forEach((_, idx) => {
                        const cell = document.getElementById(`dsyl-cell-${idx}`);
                        if (!cell) return;
                        if (idx === dictionSyllableIndex) {
                            cell.className = `${baseCls} font-black bg-studio-amber text-slate-950 shadow-sm shadow-amber-500/30 transition-colors`;
                        } else {
                            cell.className = `${baseCls} font-bold bg-studio-bg border border-studio-border/80 text-slate-300 transition-colors`;
                        }
                    });
                    dictionSyllableIndex = (dictionSyllableIndex + 1) % syllables.length;
                }

                dictionBeatIndex = (dictionBeatIndex + 1) % 4;
            };

            tick();
            dictionMetroTimer = setInterval(tick, intervalMs);
        }

