                    <button onclick="toggleCustomDictionForm()" class="px-3 py-2 rounded-xl bg-studio-amber hover:bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center gap-1 shadow-md shadow-amber-500/20 transition active:scale-[0.98]">
                        <span>+ Своя таблица</span>
                    </button>
                </div>

                <!-- Форма добавления своей таблицы согласных -->
