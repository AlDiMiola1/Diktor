        function renderExercisesCatalog() {
            const container = document.getElementById('exercisesCatalogList');
            const countBadge = document.getElementById('filteredCountBadge');
            if (!container) return;

            const list = activeModuleFilter === 'all'
                ? EXERCISES_DB
