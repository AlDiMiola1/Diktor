<!DOCTYPE html>
<html lang="ru" class="dark overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Диктор PRO 2.5 — Студийный тренажер голоса</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Шрифты Inter и JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        studio: {
                            bg: '#0B0F19',
                            card: '#131A2A',
                            surface: '#1A2338',
                            border: '#25314B',
                            amber: '#F59E0B',
                            cyan: '#38BDF8',
                            emerald: '#10B981',
                            rose: '#F43F5E'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Базовые студийные стили */
        body {
            background-color: #0B0F19;
            color: #F1F5F9;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: none;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Анимации для SVG-тренажеров */
        @keyframes larynxDrop {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(14px); }
        }
        @keyframes palateLift {
            0%, 100% { transform: translateY(0px) scaleY(1); }
            50% { transform: translateY(-9px) scaleY(0.85); }
        }
        .anim-larynx { animation: larynxDrop 4s infinite ease-in-out; }
        .anim-palate { animation: palateLift 4s infinite ease-in-out; }

        @keyframes lipFlutter {
            0%, 100% { transform: scaleY(1) translateX(0); }
            25% { transform: scaleY(0.65) translateX(2px); }
            50% { transform: scaleY(1.25) translateX(-2px); }
            75% { transform: scaleY(0.75) translateX(1px); }
        }
        .anim-flutter { animation: lipFlutter 0.14s infinite linear; transform-origin: center; }

        @keyframes chestWave {
            0% { transform: scale(0.7); opacity: 0.9; }
            100% { transform: scale(1.75); opacity: 0; }
        }
        .anim-chest-ring-1 { animation: chestWave 2s infinite ease-out; transform-origin: center; }
        .anim-chest-ring-2 { animation: chestWave 2s infinite ease-out 0.65s; transform-origin: center; }
        .anim-chest-ring-3 { animation: chestWave 2s infinite ease-out 1.3s; transform-origin: center; }

        @keyframes neckPendulum {
            0%, 100% { transform: rotate(-22deg); }
            50% { transform: rotate(22deg); }
        }
        .anim-pendulum { animation: neckPendulum 3.6s infinite ease-in-out; transform-origin: 60px 35px; }

        @keyframes tongueOrbit {
            0%   { transform: translate(0px, -18px); }
            25%  { transform: translate(22px, 0px); }
            50%  { transform: translate(0px, 18px); }
            75%  { transform: translate(-22px, 0px); }
            100% { transform: translate(0px, -18px); }
        }
        .anim-tongue-orbit { animation: tongueOrbit 2.4s infinite linear; }

        @keyframes soundArcDash {
            to { stroke-dashoffset: -32; }
        }
        .anim-sound-arc {
            stroke-dasharray: 8 8;
            animation: soundArcDash 1.1s infinite linear;
        }

        /* Пульсация кнопки записи */
        .rec-pulse {
            animation: recRing 1.5s infinite;
        }
        @keyframes recRing {
            0% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.65); }
            70% { box-shadow: 0 0 0 14px rgba(244, 63, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
        }

        /* Разметка телесуфлера */
        .tp-stress {
            color: #F59E0B;
            font-weight: 800;
            background: rgba(245, 158, 11, 0.14);
            padding: 0 4px;
            border-radius: 5px;
            text-decoration: underline;
            text-decoration-color: rgba(245, 158, 11, 0.55);
            text-underline-offset: 4px;
        }
        .tp-pause-short {
            display: inline-block;
            color: #38BDF8;
            font-weight: 900;
            padding: 0 5px;
            margin: 0 2px;
            background: rgba(56, 189, 248, 0.16);
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 5px;
        }
        .tp-pause-deep {
            display: inline-block;
            color: #F59E0B;
            font-weight: 900;
            padding: 0 6px;
            margin: 0 3px;
            background: rgba(245, 158, 11, 0.18);
            border: 1px solid rgba(245, 158, 11, 0.45);
            border-radius: 5px;
        }
        .tp-arrow-up {
            color: #10B981;
            font-weight: 900;
        }
        .tp-arrow-down {
            color: #F59E0B;
            font-weight: 900;
        }

        /* Стилизация ползунка */
        input[type=range] {
            -webkit-appearance: none;
            background: transparent;
        }
        input[type=range]::-webkit-slider-runnable-track {
            height: 6px;
            background: #25314B;
            border-radius: 999px;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 20px;
            width: 20px;
            border-radius: 50%;
            background: #F59E0B;
            margin-top: -7px;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
        }
    </style>
</head>
<body class="min-h-screen max-w-full overflow-x-hidden flex flex-col justify-between antialiased selection:bg-amber-500/30 selection:text-amber-200">

    <!-- ВЕРХНЯЯ СТУДИЙНАЯ ПАНЕЛЬ -->
    <header class="sticky top-0 z-30 max-w-full overflow-x-hidden bg-[#0B0F19]/95 backdrop-blur-md border-b border-studio-border">
        <div class="max-w-[540px] mx-auto px-3.5 py-2.5 flex items-center justify-between gap-2">
            <!-- Логотип и название -->
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-lg shadow-amber-500/20 shrink-0">
                    <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z"/>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                        <h1 class="text-sm sm:text-base font-black text-white tracking-tight truncate">Диктор PRO</h1>
                        <span class="px-1.5 py-0.5 rounded bg-studio-amber/15 text-studio-amber font-mono text-[9px] font-extrabold shrink-0">2.7</span>
                    </div>
                    <p class="text-[10px] text-slate-400 truncate">Студия постановки голоса</p>
                </div>
            </div>

            <!-- Правая панель управления -->
            <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                <!-- Кнопка Справки / Инструкции -->
                <button onclick="openHelpModal()" title="Инструкция по приложению" class="px-2 sm:px-2.5 h-8 rounded-xl bg-studio-cyan/15 border border-studio-cyan/40 flex items-center gap-1 text-studio-cyan hover:bg-studio-cyan/25 transition">
                    <span class="font-mono text-xs font-black">?</span>
                    <span class="text-[10px] font-extrabold">Справка</span>
                </button>

                <!-- Индикатор серии дней тренировок -->
                <div id="headerStreakBadge" title="Серия дней тренировок" class="px-1.5 sm:px-2 h-8 rounded-xl bg-studio-card border border-studio-border flex items-center gap-1 text-studio-amber font-mono text-[11px] font-extrabold">
                    <span>🔥</span>
                    <span id="headerStreakDays">1</span><span>д</span>
                </div>

                <!-- Кнопка API ключа Gemini -->
                <button onclick="openApiKeyModal()" title="API ключ Gemini (опционально)" class="px-1.5 sm:px-2 h-8 rounded-xl bg-studio-card border border-studio-border flex items-center gap-1 text-slate-300 hover:border-studio-amber hover:text-studio-amber transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/>
                    </svg>
                    <span id="apiKeyStatusBadge" class="text-[10px] font-mono font-bold">API</span>
                </button>

                <!-- Переключатель звука тренажера -->
                <button onclick="toggleSoundMute()" id="soundMuteBtn" title="Звуки таймеров и метронома" class="w-8 h-8 rounded-xl bg-studio-card border border-studio-border flex items-center justify-center text-studio-amber hover:border-slate-600 transition">
                    <svg id="soundOnIcon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/>
                    </svg>
                    <svg id="soundOffIcon" class="w-4 h-4 hidden text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/>
                    </svg>
                </button>

                <!-- Индикатор студии -->
                <div class="hidden sm:flex items-center gap-1.5 bg-studio-card border border-studio-border px-2.5 py-1.5 rounded-xl">
                    <span id="studioLedDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="studioLedText" class="text-[10px] font-mono font-bold text-slate-300">REC</span>
                </div>
            </div>
        </div>
    </header>

    <!-- КОНТЕЙНЕР ВСПЛЫВАЮЩИХ УВЕДОМЛЕНИЙ -->
    <div id="toastContainer" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 w-full max-w-[440px] px-4 space-y-2 pointer-events-none flex flex-col items-center"></div>

    <!-- ОСНОВНОЙ КОНТЕЙНЕР ЭКРАНА -->
    <main class="max-w-[540px] mx-auto w-full px-3.5 pt-4 pb-28 flex-1">

        <!-- ===================================================================== -->
        <!-- ВКЛАДКА 1: ТРЕНИРОВКИ (Автокурс + полная база из 32 упражнений)       -->
        <!-- ===================================================================== -->
        <section id="tab-trainings" class="space-y-4">

            <!-- БЛОК: АВТОМАТИЧЕСКАЯ ПРОГРАММА НА СЕГОДНЯ -->
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Автокурс • Программа на сегодня</h2>
                    <span id="dailyCourseCycleLabel" class="text-[11px] font-mono text-studio-cyan font-bold">Цикл 1 • День 1/14</span>
                </div>

                <!-- Главная карточка текущего дня курса -->
                <div id="dailyCourseHeroCard" class="bg-studio-card border border-studio-amber/50 rounded-2xl p-4 shadow-xl space-y-3.5">
                    <div class="flex items-start justify-between gap-2">
                        <div class="space-y-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span id="dailyCourseDayBadge" class="px-2.5 py-0.5 rounded-md bg-studio-amber text-slate-950 font-mono text-[11px] font-black">ДЕНЬ 1</span>
                                <span id="dailyCourseDurationBadge" class="px-2 py-0.5 rounded-md bg-studio-bg border border-studio-border text-slate-300 font-mono text-[10px] font-bold">~6 МИН</span>
                            </div>
                            <h3 id="dailyCourseDayTitle" class="text-base font-black text-white leading-snug pt-0.5">Снятие зажимов и запуск опоры</h3>
                            <p id="dailyCourseDayFocus" class="text-xs text-slate-400">Опускаем гортань, включаем диафрагму и грудной резонатор</p>
                        </div>
                        <span id="dailyTodayStatusBadge" class="px-2.5 py-1 rounded-xl bg-studio-amber/15 border border-studio-amber/40 text-studio-amber text-[10px] font-extrabold shrink-0">
                            ⏳ Не пройдено
                        </span>
                    </div>

                    <!-- Трекер текущей недели (Пн – Вс) -->
                    <div class="bg-studio-bg/90 border border-studio-border rounded-xl p-2.5 space-y-1.5">
                        <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold">
                            <span>Активность на этой неделе:</span>
                            <span id="dailyWeekDoneCount" class="font-mono text-emerald-400 font-bold">0 / 7 дн.</span>
                        </div>
                        <div id="dailyWeekTrackerStrip" class="grid grid-cols-7 gap-1.5"></div>
                    </div>

                    <!-- Пошаговый состав сегодняшней тренировки -->
                    <div class="space-y-1.5">
                        <div class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Упражнения на сегодня по порядку:</div>
                        <div id="dailyCourseStepsPreview" class="space-y-1"></div>
                    </div>

                    <!-- Кнопка запуска сегодняшнего дня -->
                    <div class="space-y-2 pt-0.5">
                        <button id="startDailyCourseBtn" onclick="startDailyCourseWorkout()" class="w-full py-3.5 px-4 rounded-xl bg-studio-amber hover:bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition active:scale-[0.99]">
                            <span>▶ Начать тренировку Дня 1</span>
                        </button>
                        <button id="unlockNextDayEarlyBtn" onclick="advanceToNextCourseDayEarly()" class="hidden w-full py-2.5 px-3 rounded-xl bg-studio-bg hover:bg-studio-surface border border-studio-cyan/40 text-studio-cyan font-extrabold text-xs transition">
                            Открыть следующий день досрочно →
                        </button>
                    </div>
                </div>

                <!-- Компактный быстрый разогрев вне расписания -->
                <button onclick="startProgram('express')" class="w-full bg-studio-card hover:bg-studio-surface border border-studio-border rounded-xl px-3.5 py-2.5 flex items-center justify-between gap-2 text-left transition active:scale-[0.99]">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="px-2 py-0.5 rounded bg-studio-cyan/15 text-studio-cyan font-mono text-[10px] font-extrabold shrink-0">4 МИН</span>
                        <span class="text-xs font-extrabold text-slate-200 truncate">Экспресс-разогрев перед созвоном или записью</span>
                    </div>
                    <span class="text-xs font-black text-studio-amber shrink-0">▶</span>
                </button>
            </div>

            <!-- БЛОК: КАТАЛОГ ВСЕХ 32 УПРАЖНЕНИЙ ПО 5 МОДУЛЯМ -->
            <div class="space-y-2.5 pt-1">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-400">База отдельных упражнений (5 модулей)</h2>
                    <span id="filteredCountBadge" class="text-[11px] font-mono text-studio-amber font-bold">32 упр.</span>
                </div>

                <!-- Фильтры модулей с переносом строк -->
                <div class="flex flex-wrap gap-1.5" id="moduleFiltersBar">
                    <button onclick="filterExercises('all')" data-mod="all" class="mod-btn active px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-amber text-slate-950 transition">
                        Все (32)
                    </button>
                    <button onclick="filterExercises('clamps')" data-mod="clamps" class="mod-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-card text-slate-300 border border-studio-border transition">
                        1. Зажимы (6)
                    </button>
                    <button onclick="filterExercises('breath')" data-mod="breath" class="mod-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-card text-slate-300 border border-studio-border transition">
                        2. Дыхание (6)
                    </button>
                    <button onclick="filterExercises('resonators')" data-mod="resonators" class="mod-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-card text-slate-300 border border-studio-border transition">
                        3. Резонаторы и штробас (8)
                    </button>
                    <button onclick="filterExercises('articulation')" data-mod="articulation" class="mod-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-card text-slate-300 border border-studio-border transition">
                        4. Артикуляция (6)
                    </button>
                    <button onclick="filterExercises('intonation')" data-mod="intonation" class="mod-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-studio-card text-slate-300 border border-studio-border transition">
                        5. Интонация (6)
                    </button>
                </div>

                <!-- Компактный список упражнений -->
                <div id="exercisesCatalogList" class="space-y-1.5"></div>
            </div>
        </section>

        <!-- ===================================================================== -->
        <!-- ВКЛАДКА 2: СТУДИЯ И ИИ (Телесуфлер + Свои тексты + Запись + Разбор)   -->
        <!-- ===================================================================== -->
        <section id="tab-studio" class="hidden space-y-4">

            <!-- Панель выбора сценария + кнопка «+ Свой текст» -->
            <div class="bg-studio-card border border-studio-border rounded-2xl p-4 space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h2 class="text-sm font-extrabold text-white">Студийный телесуфлер</h2>
                        <p class="text-[11px] text-slate-400">Читай по разметке и записывай дубль для ИИ</p>
                    </div>
                    <button onclick="toggleCustomScriptForm()" class="px-3.5 py-2 rounded-xl bg-studio-amber hover:bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center gap-1.5 shadow-lg shadow-amber-500/20 transition active:scale-[0.98]">
                        <span>+ Свой текст</span>
                    </button>
                </div>

                <!-- Форма добавления своего сценария в телесуфлер -->
                <div id="customScriptFormBox" class="hidden bg-studio-bg border border-studio-amber/60 rounded-2xl p-3.5 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold text-studio-amber">Новый сценарий для суфлера</span>
                        <button onclick="toggleCustomScriptForm()" class="text-xs font-bold text-slate-400 hover:text-white px-2 py-0.5">✕ Закрыть</button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <input type="text" id="newScriptTitleInput" placeholder="Название сценария..." class="sm:col-span-2 bg-studio-card border border-studio-border rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-studio-amber">
                        <select id="newScriptGenreSelect" class="bg-studio-card border border-studio-border rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-studio-amber">
                            <option value="custom">Мой сценарий</option>
                            <option value="news">Новости</option>
                            <option value="trailer">Реклама</option>
                            <option value="audiobook">Аудиокнига</option>
                        </select>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[10px] font-bold text-slate-400 mr-1">Разметка:</span>
                        <button type="button" onclick="insertMarkupAtCursor(' | ')" class="px-2 py-1 rounded-lg bg-studio-card border border-studio-cyan/40 text-studio-cyan font-mono text-xs font-bold">+ |</button>
                        <button type="button" onclick="insertMarkupAtCursor(' || ')" class="px-2 py-1 rounded-lg bg-studio-card border border-studio-amber/40 text-studio-amber font-mono text-xs font-bold">+ ||</button>
                        <button type="button" onclick="insertAccentMarkupAtCursor()" class="px-2 py-1 rounded-lg bg-studio-card border border-studio-amber/40 text-amber-300 font-mono text-xs font-bold">+ *акцент*</button>
                        <button type="button" onclick="insertMarkupAtCursor(' ↗')" class="px-2 py-1 rounded-lg bg-studio-card border border-emerald-500/40 text-emerald-400 font-mono text-xs font-bold">+ ↗</button>
                        <button type="button" onclick="insertMarkupAtCursor(' ↘')" class="px-2 py-1 rounded-lg bg-studio-card border border-studio-amber/40 text-studio-amber font-mono text-xs font-bold">+ ↘</button>
                    </div>
                    <textarea id="newScriptBodyInput" rows="4" placeholder="Введите текст... Используйте *слово* для грудного акцента и | или || для пауз." class="w-full bg-studio-card border border-studio-border rounded-xl p-3 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-studio-amber leading-relaxed"></textarea>
