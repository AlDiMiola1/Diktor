        function formatMMSS(sec) {
            const s = Math.max(0, Math.floor(sec));
            return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
        }

        function attachSimpleCountdown(btnId, displayId, totalSec, onDoneText = 'Готово!') {
            let remaining = totalSec;
            let running = false;
            const btn = document.getElementById(btnId);
            const disp = document.getElementById(displayId);
            if (!btn || !disp) return;

            btn.onclick = () => {
                if (running) {
                    running = false;
                    btn.textContent = '▶ Продолжить';
                    return;
                }
                if (remaining <= 0) remaining = totalSec;
                running = true;
                btn.textContent = '⏸ Пауза';
                soundFX.playChime('phase');

                const tid = setInterval(() => {
                    if (!running) {
                        clearInterval(tid);
                        return;
                    }
                    remaining -= 1;
                    disp.textContent = formatMMSS(remaining);
                    if (remaining <= 0) {
                        running = false;
                        clearInterval(tid);
                        disp.textContent = onDoneText;
                        btn.textContent = '↻ Повторить';
                        soundFX.playChime('complete');
                    }
                }, 1000);
                modalIntervals.push(tid);
            };
        }

