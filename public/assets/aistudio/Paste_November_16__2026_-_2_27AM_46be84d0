         * 4. LOCALSTORAGE: СОХРАНЕНИЕ ПРОГРЕССА, СВОИХ ТЕКСТОВ, СКОРОГОВОРОК И КЛЮЧА
         * ========================================================================= */
        const STORAGE_KEY = 'diktor_pro_v2_3_data';

        function getTodayIsoDate() {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function getOffsetIsoDate(daysOffset) {
            const d = new Date();
            d.setDate(d.getDate() + daysOffset);
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function loadAppState() {
            const today = getTodayIsoDate();
            try {
                const raw = localStorage.getItem(STORAGE_KEY) || localStorage.getItem('diktor_pro_v2_2_data');
                if (raw) {
                    const p = JSON.parse(raw);
                    return {
                        completedExercises: Array.isArray(p.completedExercises) ? p.completedExercises : [],
                        totalExerciseRuns: p.totalExerciseRuns || 0,
                        completedPrograms: p.completedPrograms || 0,
                        egorkiBestCount: p.egorkiBestCount || 0,
                        streakDays: p.streakDays || 0,
                        lastActiveDate: p.lastActiveDate || today,
                        courseDayNumber: Math.max(1, Number(p.courseDayNumber) || 1),
                        completedDates: Array.isArray(p.completedDates) ? p.completedDates : [],
                        lastCompletedCourseDate: typeof p.lastCompletedCourseDate === 'string' ? p.lastCompletedCourseDate : '',
                        lastAdvancedDate: typeof p.lastAdvancedDate === 'string' ? p.lastAdvancedDate : '',
                        customScripts: Array.isArray(p.customScripts) ? p.customScripts : [],
                        customTwisters: Array.isArray(p.customTwisters) ? p.customTwisters : [],
                        customDictionTables: Array.isArray(p.customDictionTables) ? p.customDictionTables : [],
                        aiHistory: Array.isArray(p.aiHistory) ? p.aiHistory : [],
                        geminiApiKey: typeof p.geminiApiKey === 'string' ? p.geminiApiKey : ''
                    };
                }
            } catch (e) {}
            return {
                completedExercises: [],
                totalExerciseRuns: 0,
                completedPrograms: 0,
                egorkiBestCount: 0,
                streakDays: 0,
                lastActiveDate: today,
                courseDayNumber: 1,
                completedDates: [],
                lastCompletedCourseDate: '',
                lastAdvancedDate: '',
                customScripts: [],
                customTwisters: [],
                customDictionTables: [],
                aiHistory: [],
                geminiApiKey: ''
            };
        }

        function saveAppState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {}
        }

        function calculateCurrentStreak() {
            const datesSet = new Set(appState.completedDates || []);
            if (!datesSet.size) return 0;

            const today = getTodayIsoDate();
            const yesterday = getOffsetIsoDate(-1);
            let offset = datesSet.has(today) ? 0 : (datesSet.has(yesterday) ? -1 : null);
            if (offset === null) return 0;

            let streak = 0;
            while (datesSet.has(getOffsetIsoDate(offset))) {
                streak += 1;
                offset -= 1;
            }
            return streak;
        }

        function syncDailyCourseProgression() {
            const today = getTodayIsoDate();
            // Если предыдущий день курса был пройден в прошлую календарную дату — автоматически переходим на следующий день!
            if (
                appState.lastCompletedCourseDate &&
                appState.lastCompletedCourseDate < today &&
                appState.lastAdvancedDate !== today
            ) {
                appState.courseDayNumber = (appState.courseDayNumber || 1) + 1;
                appState.lastAdvancedDate = today;
                saveAppState();
            }
            appState.streakDays = calculateCurrentStreak();
            updateHeaderStreakUI();
        }

        function recordDailyStreakActivity() {
            appState.lastActiveDate = getTodayIsoDate();
            appState.streakDays = calculateCurrentStreak();
            saveAppState();
            updateHeaderStreakUI();
